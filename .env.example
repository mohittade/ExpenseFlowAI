# ExpenseFlow AI Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database
DATABASE_URL=sqlite:///expense_flow.db

# Redis (for persistent workflow state)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# LLM Configuration (NVIDIA Nemotron)
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4000

# LLM Retry Settings
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=2.0
LLM_RETRY_MAX_WAIT=10.0

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FINANCE_EMAIL=finance@company.com

# Observability (OpenTelemetry)
OTEL_ENDPOINT=http://localhost:4317
SERVICE_NAME=expense-flow-ai
LOG_LEVEL=INFO

# Feature Flags
ENABLE_HUMAN_APPROVAL=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PDF_GENERATION=true